<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow debug builds to trust user-installed CA certificates for proxy inspection -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
